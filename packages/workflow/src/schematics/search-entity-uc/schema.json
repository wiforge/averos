{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "SchematicsSearchEntityUseCase",
  "title": "Creates a Search Entity Use Case for the entity ename",
  "type": "object",
  "properties": {
    "name": {
      "description": "The name of the component.",
      "type": "string",
      "minLength": 1,
      "x-prompt": "What is the name of the component?"
    },
    "ename": {
      "description": "The target entity name.",
      "type": "string",
      "minLength": 1,
      "x-prompt": "What is the name of the entity subject to this Use Case ?"
    },
    "path": {
      "type": "string",
      "format": "path",
      "description": "The path to create the use case component.",
      "visible": false,
      "$default": {
        "$source": "workingDirectory"
       }
    }
   },
  "required": [
    "name"
  ]
}
