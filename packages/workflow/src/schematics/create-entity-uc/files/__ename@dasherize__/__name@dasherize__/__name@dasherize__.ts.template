                    ${this.useCaseConfig.entity!==null && this.useCaseConfig.entity!==undefined 
                    ? (this.useCaseConfig.entity as Indexable)[TypeScriptTypeMetaDatatHandler.instance.getBusinessIdName(this.useCaseConfig.entityType)]
                    : ''}:entity:
