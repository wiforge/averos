{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "SchematicsPredefinedValidatorGlobalCustomValidator",
  "title": "Configures a predefined validator for a specific entity field",
  "type": "object",
  "properties": {
   "validatorId": {
      "description": "The Validator action name (method name)",
      "type": "string",
      "minLength": 1,
      "enum": [
        "regExpPatternValidator",
        "emailAlreadyexistsValidator",
        "birthDateValidator"
      ],
      "x-prompt": {
        "message": "please choose one of the predefined validation action to configure with your field...",
        "type": "list",
        "items": [
          { "value": "regExpPatternValidator", "label": "regExpPatternValidator" },
          { "value": "emailAlreadyexistsValidator", "label": "emailAlreadyexistsValidator" },
          { "value": "birthDateValidator", "label": "birthDateValidator" }
        ]
      }
    }
   },
  "required": [
    "validatorId"
  ]
}