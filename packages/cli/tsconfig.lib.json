{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "composite": true,
    "importHelpers": true,
    "isolatedModules": true,
    "noEmitOnError": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"],
    "paths": {
      "@averos/ai":           ["../ai/src/index.ts"],
      "@averos/ai/*":         ["../ai/src/*"]
    }

  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "jest.config.cts"
  ],
  "references": [
    { "path": "../ai/tsconfig.lib.json" }
  ]
}