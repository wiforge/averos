{
  "name": "@wiforge/averos",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Averos — a deterministic AI-Native software generation platform. Compiles natural language intent into production-ready applications through an adapter-agnostic four-layer pipeline: LLM manifest design, schema validation, dependency-ordered DAG execution planning, and resumable execution — with MCP server integration and full CLI support.",
  "keywords": [
    "averos",
    "code-generation",
    "ai-assisted-development",
    "llm",
    "dag",
    "directed-acyclic-graph",
    "schematics",
    "angular-schematics",
    "mcp",
    "model-context-protocol",
    "claude",
    "anthropic",
    "ollama",
    "gemini",
    "local-llm",
    "natural-language-to-code",
    "intent-to-application",
    "manifest-driven",
    "json-ir",
    "deterministic-pipeline",
    "compiler",
    "validation",
    "execution-plan",
    "checkpointing",
    "resumable",
    "idempotent",
    "incremental-generation",
    "cli",
    "developer-tooling",
    "low-code",
    "no-code"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wiforge/averos.git"
  },
  "author": "averos-io<averos.tech@gmail.com>",
  "bugs": "https://github.com/wiforge/averos/issues",
  "homepage": "https://github.com/wiforge/averos#readme",
  "engines": {
    "node": ">=22.0.0",
    "npm": "Please use pnpm instead of NPM to install dependencies",
    "yarn": "Please use pnpm instead of Yarn to install dependencies",
    "pnpm": ">=11.0.0"
  },
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "integration:executor": "bash scripts/integration/integration-test-executor.sh",
    "integration:ai":       "bash scripts/integration/integration-test-ai.sh",
    "smoke:plan":           "bash scripts/smoke/minimal-plan.sh",
    "smoke:run":            "bash scripts/smoke/minimal-run.sh",
    "smoke:gr-run":         "bash scripts/smoke/golden-reference-run.sh",
    "smoke:gr-plan":        "bash scripts/smoke/golden-reference-plan.sh",
    "smoke:all":            "pnpm run smoke:plan && pnpm run smoke:run && pnpm run smoke:gr-plan && pnpm run smoke:gr-run",
    "integration:all":      "pnpm run integration:executor && pnpm run integration:ai",
    "e2e":                  "bash scripts/e2e/run-real-angular.sh",
    "e2e:local":            "bash scripts/e2e/run-local-angular.sh --tgz=scripts/e2e/wiforge-averos-2.0.0.tgz --averos-version=2.0.0",
    "e2e:keep":             "bash scripts/e2e/run-real-angular.sh --keep-workspace",
    "e2e:local:keep":       "bash scripts/e2e/run-local-angular.sh --keep-workspace --tgz=scripts/e2e/wiforge-averos-2.0.0.tgz --averos-version=2.0.0",
    "e2e:skip-build":       "bash scripts/e2e/run-real-angular.sh --skip-build",
    "e2e:dry":              "bash scripts/e2e/run-real-angular.sh --dry-run --skip-build",
    "e2e:local:dry":        "bash scripts/e2e/run-local-angular.sh --dry-run --tgz=scripts/e2e/wiforge-averos-2.0.0.tgz --averos-version=2.0.0",

    "registry":               "pnpm nx run @wiforge/averos:local-registry",
    "serveapp:dev":           "pnpm nx serve averos-application --configuration=dev-lib --host 0.0.0.0",
    "build:ui-platform":      "pnpm nx build @averos/ui-platform",
    "build:app:prod":         "pnpm nx build averos-application",
    "build:app:dev":          "pnpm nx build averos-application --configuration=development",
    "build:app:fordebug":     "pnpm nx build averos-application --configuration=dev-lib",

    "pack:ui-platform":               "pnpm nx run @averos/ui-platform:pack",
    "publish-locally:ui-platform":    "pnpm nx run @averos/ui-platform:publish-locally",
    "unpublish-locally:ui-platform":  "pnpm nx run @averos/ui-platform:unpublish-locally",
    "publish:ui-platform":            "pnpm nx run @averos/ui-platform:publish",
    "publish-dry-run:ui-platform":    "pnpm nx run @averos/ui-platform:publish --configuration=dry-run",
    "republish-locally:ui-platform":  "pnpm run unpublish-locally:ui-platform; pnpm run publish-locally:ui-platform",

    "pack:cli":               "pnpm nx run @averos/cli:pack",
    "publish-locally:cli":    "pnpm nx run @averos/cli:publish-locally",
    "unpublish-locally:cli":  "pnpm nx run @averos/cli:unpublish-locally",
    "publish:cli":            "pnpm nx run @averos/cli:publish",
    "publish-dry-run:cli":    "pnpm nx run @averos/cli:publish --configuration=dry-run",
    "republish-locally:cli":  "pnpm run unpublish-locally:cli; pnpm run publish-locally:cli",

    "pack:ai":               "pnpm nx run @averos/ai:pack",
    "publish-locally:ai":    "pnpm nx run @averos/ai:publish-locally",
    "unpublish-locally:ai":  "pnpm nx run @averos/ai:unpublish-locally",
    "publish:ai":            "pnpm nx run @averos/ai:publish",
    "publish-dry-run:ai":    "pnpm nx run @averos/ai:publish --configuration=dry-run",

    "pack:mcp":               "pnpm nx run @averos/mcp:pack",
    "publish-locally:mcp":    "pnpm nx run @averos/mcp:publish-locally",
    "unpublish-locally:mcp":  "pnpm nx run @averos/mcp:unpublish-locally",
    "publish:mcp":            "pnpm nx run @averos/mcp:publish",
    "publish-dry-run:mcp":    "pnpm nx run @averos/mcp:publish --configuration=dry-run",

    "build-dev:workflow":          "pnpm nx run @averos/workflow:build-dev",
    "build:workflow":              "pnpm nx run @averos/workflow:build",
    "pack:workflow":               "pnpm nx run @averos/workflow:pack",
    "publish-locally:workflow":    "pnpm nx run @averos/workflow:publish-locally",
    "unpublish-locally:workflow":  "pnpm nx run @averos/workflow:unpublish-locally",
    "publish:workflow":            "pnpm nx run @averos/workflow:publish",
    "publish-dry-run:workflow":    "pnpm nx run @averos/workflow:publish --configuration=dry-run",
    "republish-locally:workflow":  "pnpm run unpublish-locally:workflow; pnpm run publish-locally:workflow",

    "build:all":             "pnpm nx run-many -t build --projects=tag:scope:averos",
    "pack:all":              "pnpm nx run-many -t pack --projects=tag:scope:averos",
    "unpublish-locally:all": "pnpm nx run-many -t unpublish-locally --projects=tag:scope:averos",
    "publish-locally:all":   "pnpm nx run-many -t publish-locally --projects=tag:scope:averos",
    "republish-locally:all": "pnpm run unpublish-locally:all; pnpm run publish-locally:all",

    "sync:core": "pnpm update @averos/core --latest --recursive",
    "refresh:core": "pnpm store prune && rm -rf node_modules/.pnpm/@averos+core@* && pnpm install --force"


  },
  "devDependencies": {
    "nx":                                 "catalog:",
