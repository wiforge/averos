{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@averos/ui-platform":    ["./packages/ui-platform/src/index.ts"],
      "@averos/ui-platform/*":  ["./packages/ui-platform/src/*"],
      "@averos/mcp":            ["./packages/mcp/src/index.ts"],
      "@averos/mcp/*":          ["./packages/mcp/src/*"],
      "@averos/cli":            ["./packages/cli/src/index.ts"],
      "@averos/cli/*":          ["./packages/cli/src/*"],
      "@averos/ai":             ["./packages/ai/src/index.ts"],
      "@averos/ai/*":           ["./packages/ai/src/*"],
      "@averos/workflow":       ["./packages/workflow/src/index.ts"],
      "@averos/workflow/*":     ["./packages/workflow/src/*"]
      
    }
  }
}
