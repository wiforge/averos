{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "noUnusedParameters": false,
    "noUnusedLocals": false, 
    "experimentalDecorators": true,  
    "emitDecoratorMetadata": true,
    "moduleResolution": "bundler",   
    "module": "preserve",
    "lib": ["ES2022", "dom"],
    "target": "ES2022", 
    "useDefineForClassFields": false,
    "paths": {
       "@averos/ui-platform": ["../../packages/ui-platform/src/public-api.ts"],
       "@averos/ui-platform/*": ["../../packages/ui-platform/src/*"],
       "@averos/ui-platform/core/*": ["../../packages/ui-platform/src/averos-core/*"],
       "@averos/ui-platform/shared/*": ["../../packages/ui-platform/src/averos-shared/*"],
       "@averos/ui-platform/view/*": ["../../packages/ui-platform/src/view/*"],
       "@averos/ui-platform/referential/*": ["../../packages/ui-platform/src/referential/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true  
  },  
  "files": ["src/main.ts"],
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"]
}
